pipeline {
    agent any

    parameters {
        string(name: 'BRANCH', defaultValue: 'dev', description: 'Git Branch to deploy')

        choice(name: 'ENVIRONMENT', choices: ['dev', 'staging', 'prod'], description: 'Environment to deploy')
    }

    environment {
        DJANGO_EC2_IP = "${params.ENVIRONMENT == 'dev' ? 'ec2-54-216-182-84.eu-west-1.compute.amazonaws.com' : (params.ENVIRONMENT == 'staging' ? 'ec2-staging-ip' : 'ec2-prod-ip')}"

        SHELL_SCRIPT_PATH = "/var/lib/jenkins/workspace/scripts/pipeline_my_psychometric_exam.sh"

        SLACK_WEBHOOK_URL = credentials('slack-webhook-url')
    }

    stages {
        stage('Checkout Code') {
            steps {
                // Check out the specific branch provided as a parameter
                checkout([$class: 'GitSCM', branches: [[name: "refs/heads/${params.BRANCH}"]],
                          userRemoteConfigs: [[url: 'https://github.com/r-naeem-afzal/my-psychometric-exam.git',
                                               credentialsId: '7016e7f8-9b7e-43a5-800c-197216dd0ec8']]]) // Updated token
            }
        }

        stage('Deploy to Server') {
            steps {
                script {
                    // Use SSH credentials to deploy the application to the EC2 instance
                    sshagent(['django-ec2-ssh-key']) {
                        sh """
                            ssh -o StrictHostKeyChecking=no ubuntu@${DJANGO_EC2_IP} 'bash ${SHELL_SCRIPT_PATH} ${params.ENVIRONMENT} ${params.BRANCH}'
                        """
                    }
                }
            }
        }

        stage('Notify Slack: Deployment Started') {
            steps {
                script {
                    // Send a notification to Slack when the deployment starts
                    sh """
                        curl -X POST -H 'Content-type: application/json' --data '{"text":"Deployment started for branch ${params.BRANCH} in ${params.ENVIRONMENT} environment."}' ${SLACK_WEBHOOK_URL}
                    """
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }

        success {
            script {
                sh """
                    curl -X POST -H 'Content-type: application/json' --data '{"text":"Branch ${params.BRANCH} successfully deployed to ${params.ENVIRONMENT} environment."}' ${SLACK_WEBHOOK_URL}
                """
            }
        }

        failure {
            script {
                sh """
                    curl -X POST -H 'Content-type: application/json' --data '{"text":"Deployment of branch ${params.BRANCH} to ${params.ENVIRONMENT} failed."}' ${SLACK_WEBHOOK_URL}
                """
            }
        }
    }
}